#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:/bisos/panels/bisos-core/bisos-pip/bisos.gitist/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
git-sbom.pcs: the git tooling every BISOS platform needs, installed without any interaction,
so that the provisioner can run it before it clones (bxRepos-gitist.pcs).
The credentials layer (GCM over gpg/pass, gh) is gitCreds-sbom.pcs, run by hand after gpg-sbom.pcs.
Moved here from bisos/bsip4/bin/git-sbom.pcs and split (2026-11-22).
#+end_org """

from bisos import b
# from bisos.b import cmndsSeed
from bisos.b import cs
from bisos.b import b_io

# import collections
import typing

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")
ap = pkgsSeed.aptPkg


aptPkgsList = [
    ap("git"),                    # Usually in the base image; listed so that the sbom is complete.
    ap("git-lfs"),                # Repos with .gitattributes filter=lfs cannot be cloned, checked out or staged without it.
    ap("gitleaks"),               # Secrets scanning before commit / push.
]


pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        descriptionStr = """\
** Scope: git and the git tooling needed before any clone: git, git-lfs, gitleaks.

** No interaction, so the provisioner runs it:
     git-sbom.pcs -i sbom_fullUpdate
   in sysBaseGeneralAugment, after rawBisos-sbom.pcs (which installs bisos.gitist)
   and before bxRepos-gitist.pcs (which clones).

** git-lfs:
  - Installing the package does not register the LFS filters.
  - Each user's ~/.gitconfig carries [filter "lfs"] (git lfs install), or the
    platform does it once for all users: git lfs install --system
  - A ~/.gitconfig with filter.lfs.required=true and no git-lfs program makes
    every git command in an LFS repo fail ("git-lfs: not found").

** Credentials are a separate layer: gitCreds-sbom.pcs
  (Git Credential Manager over the gpg/pass BackStore of gpg-sbom.pcs, and gh).
  It needs a one-time interactive key setup, so it is run by hand.\
"""
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )

def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*Git Command Examples*')
    literal("which git git-lfs gitleaks")
    literal("git --version")
    literal("git --no-pager help")

    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Git Global Config -- Identity*')
    literal('git config --global user.name "Your Name"')
    literal('git config --global user.email "you@example.com"')
    literal("git config --global core.pager cat")
    literal("git config --global core.editor emacs")

    cs.examples.menuChapter('*Git LFS*')
    literal("git lfs version")
    literal("git lfs install            # this user: writes [filter \"lfs\"] into ~/.gitconfig")
    literal("sudo git lfs install --system   # all users: writes it into /etc/gitconfig")
    literal("git --no-pager config --show-origin --get-regexp '^filter\\.lfs'")
    literal("git lfs ls-files   # in a repo: the files LFS manages")
    literal("git lfs pull       # in a repo: fetch and check out LFS content")

    cs.examples.menuChapter('*gitleaks*')
    literal("gitleaks detect --source . --redact --no-banner -v")

    cs.examples.menuChapter('*Next Layer: Credentials*')
    literal("gpg-sbom.pcs -i readme")
    literal("gitCreds-sbom.pcs -i readme")

    cs.examples.menuChapter('*End-Of  Git Command Examples*')
    return cmndOutcome
