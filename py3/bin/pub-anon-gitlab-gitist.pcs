#!/usr/bin/env python

""" #+begin_org
* ~[Summary]~ :: A =PlantedCmndService= for Processing Git Groups and Repos
#+end_org """

from bisos.b import cs
import collections

from bisos.csSeed import seedsLib

from bisos.gitist import gitist_seed #  noqa: F401  # type: ignore[unused-import] _atExit_

from bisos.gitist import gitist_seedInfo
cntrlInfo = gitist_seedInfo.cmndsControlInfo

cntrlInfo.brand = gitist_seedInfo.GitProviderBrand.Gitlab
cntrlInfo.serverConfigPath = "~/credentials/git/gitlabHosts.cfg"
cntrlInfo.serverConfigTag = "default"

cntrlInfo.gitAccessType = gitist_seedInfo.GitAccessType.Anon
# For authenticated cloning, flip to Auth and pick a method + ssh acct:
# cntrlInfo.gitAccessType = gitist_seedInfo.GitAccessType.Auth
# cntrlInfo.gitAuthAccessMethod = gitist_seedInfo.GitAuthAccessMethod.Ssh
# cntrlInfo.gitAccessAcct = "gitlab-mohsen"   # Host alias in ~/.ssh/config

from bisos.csSeed import csCmndsList_seedInfo
csCmnd = csCmndsList_seedInfo.csCmnd

csCmndsList = [
    csCmnd("gitist_reposList",  args="mohsen.byname-group", doContinue=True),
    csCmnd("gitist_reposClone",
           pars=collections.OrderedDict([("destBaseDir", "~/gitistClones/gitlab/anon")]),
           args="mohsen.byname-group", doContinue=True),
    csCmnd("gitist_clone",
           pars=collections.OrderedDict([("destBaseDir", "~/gitistClones/gitlab/anon")]),
           args="mohsen.byname-group/mohsen.byname-project", doContinue=True),

]

csCmndsList_seedInfo.setup(
    csCmndsList=csCmndsList,
)

def examples_pcs() -> None:
    od = collections.OrderedDict
    cmnd = cs.examples.cmndEnter
    # literal = cs.examples.execInsert

    csName = seedsLib.seededCsxuInfo.seedOfThisPlant

    cs.examples.menuChapter(f'*Seed Extensions*')

    cs.examples.menuChapter('= Sample  Module  Commands=')

    uploadPars = od([('upload', "example")])
    cmnd('targetRun', csName=csName, pars=uploadPars , args="""localhost""")
